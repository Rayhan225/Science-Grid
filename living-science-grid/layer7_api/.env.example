# Local development
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/scholargrid

# Docker Compose already sets these automatically.
# JWT
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend origins (comma separated or JSON list)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000,http://localhost:3000
