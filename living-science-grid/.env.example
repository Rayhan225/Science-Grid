# ScholarGrid LaTeX Studio - Environment Variables
# Copy this file to .env and fill in your values

# Database (Supabase PostgreSQL)
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-password
DB_NAME=postgres

# Alternative: Single connection string
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# TeX Live / Chrome paths (adjust for your OS)
# Windows:
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Mac:
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux:
# CHROME_PATH=/usr/bin/google-chrome

# Optional: Custom ports
# BACKEND_PORT=8000
# FRONTEND_PORT=5173

# Python FastAPI Backend (for LaTeX Studio API endpoints)
VITE_LATEX_API_URL=http://127.0.0.1:8000

# Optional: Logging level
# LOG_LEVEL=info

# Optional: Feature flags
# ENABLE_REAL_COMPILE=true
# ENABLE_SPELL_CHECK=true
# ENABLE_CITATION_PICKER=true